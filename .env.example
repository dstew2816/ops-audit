# Copy to .env for local development. .env is gitignored.
#
# With this set, the Generate tab calls the Anthropic API directly from the
# browser. Without it the app runs in demo mode and replays recorded responses,
# which is how the deployed GitHub Pages build runs.
#
# WARNING: Vite inlines every VITE_-prefixed variable into the bundle as a
# plain string. Anything built with this set has the key embedded in its
# JavaScript. Use it for `npm run dev` and `npm run record`; never for a build
# you intend to publish.

VITE_ANTHROPIC_API_KEY=sk-ant-...
